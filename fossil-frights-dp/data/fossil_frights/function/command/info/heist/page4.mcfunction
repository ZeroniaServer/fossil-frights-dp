dialog show @s {type:"minecraft:multi_action",title:{text:"ꜰᴏssɪʟ ʜᴇɪsᴛ ɪɴꜰᴏ 4/5",color:"gold"},body:[{type:"minecraft:plain_message",contents:[{text:"ʟᴏᴏᴛ\n\n",color:"yellow"},{text:"All loot locations are specified in the loot book.\n\nCommon loot is just 1 click to get.\n\nUncommon loot requires a key stolen from the guards, then that key must be used on a lock to get loot from the basement or elsewhere.\n\nRare loot usually requires an item from the basement and a little extra work, such as visiting an anvil.\n\nHeavy loot is also 1 click to grab, but it applies extra slowness.",color:"white"}],width:360}],columns:2,actions:[{label:{text:"Previous",color:"white"},action:{type:"run_command",command:"trigger ff_cmd_info set 3"}},{label:{text:"Next",color:"white"},action:{type:"run_command",command:"trigger ff_cmd_info set 5"}}],exit_action:{label:{text:"Cancel",color:"white"}}}
