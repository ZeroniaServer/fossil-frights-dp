dialog show @s {type:"minecraft:multi_action",title:{text:"ꜰᴏssɪʟ ꜰʀɪɢʜᴛs ɪɴꜰᴏ 2/4",color:"gold"},body:[{type:"minecraft:plain_message",contents:[{text:"ʜᴏᴡ ᴛᴏ ᴘʟᴀʏ\n\n",color:"yellow"},{text:"You are a night-shift security guard in a museum. Each shift gives you a set of tasks, and you have five minutes to complete them.\n\nThe task book gives you the most important clues, but it will not explain the whole museum. Explore, learn the rooms, and remember useful routes.\n\nYou are not expected to win on your first try. Set a personal best, keep learning, and try to survive all 10 days.",color:"white"}],width:360}],columns:2,actions:[{label:{text:"Previous",color:"white"},action:{type:"run_command",command:"trigger ff_cmd_info set 1"}},{label:{text:"Next",color:"white"},action:{type:"run_command",command:"trigger ff_cmd_info set 3"}}],exit_action:{label:{text:"Cancel",color:"white"}}}
