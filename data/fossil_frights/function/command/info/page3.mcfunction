dialog show @s {type:"minecraft:multi_action",title:{text:"ꜰᴏssɪʟ ꜰʀɪɢʜᴛs ɪɴꜰᴏ 3/4",color:"gold"},body:[{type:"minecraft:plain_message",contents:[{text:"ᴇᴀsʏ ᴛᴀsᴋs\n",color:"yellow"},{text:"Easy tasks usually require going somewhere, pressing a button, or checking a specific part of the museum.\n\n",color:"white"},{text:"ᴍᴇᴅɪᴜᴍ ᴛᴀsᴋs\n",color:"yellow"},{text:"Medium tasks are trickier and always require an item. Use your Storage Key to retrieve items, often from the basement, then bring each item to the location named in the task book.\n\n",color:"white"},{text:"ʜᴀʀᴅ ᴛᴀsᴋs\n",color:"yellow"},{text:"Hard tasks are puzzles. Read the hints carefully, explore, and expect each one to work differently.",color:"white"}],width:360}],columns:2,actions:[{label:{text:"Previous",color:"white"},action:{type:"run_command",command:"trigger ff_cmd_info set 2"}},{label:{text:"Next",color:"white"},action:{type:"run_command",command:"trigger ff_cmd_info set 4"}}],exit_action:{label:{text:"Cancel",color:"white"}}}
