execute unless predicate fossil_frights:entity/door/one_way run return run execute align xyz positioned ~-1 ~ ~-1 if entity @a[dx=2,dy=1,dz=2,gamemode=!spectator,predicate=fossil_frights:player/can_automatically_open_doors,predicate=fossil_frights:location/near_door] run return 1

execute if entity @s[tag=ff_door.one_way.front] if block ~ ~ ~ #doors[hinge=right] as @a[distance=..3.5,gamemode=!spectator,predicate=fossil_frights:player/can_automatically_open_doors,predicate=fossil_frights:location/near_door] rotated ~ 0 positioned ^10 ^ ^ if predicate {condition:"minecraft:entity_properties",entity:"this",predicate:{"minecraft:distance":{x:{max:10},z:{max:10}}}} run return 1
