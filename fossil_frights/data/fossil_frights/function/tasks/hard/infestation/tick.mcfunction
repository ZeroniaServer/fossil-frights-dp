scoreboard players add @a[predicate=fossil_frights:player/team/guard] ff_infestation_bite 0
scoreboard players remove @a[scores={ff_infestation_bite=1..}] ff_infestation_bite 1
execute as @a[predicate=fossil_frights:player/team/guard,gamemode=!spectator,scores={ff_infestation_bite=0}] at @s positioned ~ ~1 ~ if entity @e[type=minecraft:silverfish,tag=ff_infestation_fixed,distance=..1.5,limit=1] run function fossil_frights:tasks/hard/infestation/bite
execute as @a[predicate=fossil_frights:player/team/guard,predicate=fossil_frights:location/room/boss_office,gamemode=!spectator] run tag @s add ff_infestation_office
execute unless entity @a[predicate=fossil_frights:player/team/guard,predicate=fossil_frights:location/room/boss_office,gamemode=!spectator,limit=1] if score $infestation_answer ff_task_state matches 2.. if entity @a[tag=ff_infestation_office,limit=1] if score $infestation_answer ff_task_state = $infestation_total ff_task_state run function fossil_frights:tasks/hard/infestation/complete
execute unless entity @a[predicate=fossil_frights:player/team/guard,predicate=fossil_frights:location/room/boss_office,gamemode=!spectator,limit=1] if score $infestation_answer ff_task_state matches 2.. if entity @a[tag=ff_infestation_office,limit=1] unless score $infestation_answer ff_task_state = $infestation_total ff_task_state positioned -32 82 79 as @a[tag=ff_infestation_office,limit=1,sort=nearest] run function fossil_frights:tasks/hard/infestation/fail
execute as @a[tag=ff_infestation_office,predicate=!fossil_frights:location/room/boss_office] run tag @s remove ff_infestation_office
