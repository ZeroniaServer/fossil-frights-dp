execute store result score #amount ff_dummy if entity @a[predicate=fossil_frights:player/team/thief]
execute if score #amount ff_dummy matches 0 run tellraw @a {translate:"ff.messages.announcement",color:"gold",with:[{translate:"ff.thieves_win.none",with:[{selector:"@a[predicate=fossil_frights:player/team/thief]",separator:{translate:"ff.separator"}},{font:"fossil_frights:small_caps",translate:"ff.heists.thieves",color:"red"}]}]}
execute if score #amount ff_dummy matches 1 run tellraw @a {translate:"ff.messages.announcement",color:"gold",with:[{translate:"ff.thieves_win.singular",with:[{selector:"@a[predicate=fossil_frights:player/team/thief]",separator:{translate:"ff.separator"}},{font:"fossil_frights:small_caps",translate:"ff.heists.thieves",color:"red"}]}]}
execute if score #amount ff_dummy matches 2.. run tellraw @a {translate:"ff.messages.announcement",color:"gold",with:[{translate:"ff.thieves_win.plural",with:[{selector:"@a[predicate=fossil_frights:player/team/thief]",separator:{translate:"ff.separator"}},{font:"fossil_frights:small_caps",translate:"ff.heists.thieves",color:"red"}]}]}
