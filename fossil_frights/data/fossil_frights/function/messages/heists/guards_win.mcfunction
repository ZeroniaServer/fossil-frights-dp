function fossil_frights:util/text/list_players {selector:"@a[predicate=fossil_frights:player/team/guard]"}
execute if score #list_players_amount ff_dummy matches 0 run tellraw @a {translate:"ff.messages.announcement",color:"gold",with:[{translate:"ff.guards_win.none",with:[{storage:"fossil_frights:text",nbt:"list_players",interpret:true},{font:"fossil_frights:small_caps",translate:"ff.heists.guards",color:"yellow"}]}]}
execute if score #list_players_amount ff_dummy matches 1 run tellraw @a {translate:"ff.messages.announcement",color:"gold",with:[{translate:"ff.guards_win.singular",with:[{storage:"fossil_frights:text",nbt:"list_players",interpret:true},{font:"fossil_frights:small_caps",translate:"ff.heists.guards",color:"yellow"}]}]}
execute if score #list_players_amount ff_dummy matches 2 run tellraw @a {translate:"ff.messages.announcement",color:"gold",with:[{translate:"ff.guards_win.plural",with:[{storage:"fossil_frights:text",nbt:"list_players",interpret:true},{font:"fossil_frights:small_caps",translate:"ff.heists.guards",color:"yellow"}]}]}
