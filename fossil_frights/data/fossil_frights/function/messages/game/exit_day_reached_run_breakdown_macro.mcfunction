function fossil_frights:util/text/list_players {selector:"@a[predicate=fossil_frights:player/team/guard]"}
$execute if score #list_players_amount ff_dummy matches 0 run tellraw @a {translate:"ff.messages.announcement",color:"gold",with:[{text:"",extra:[{translate:"ff.exit_day_reached.none",with:[{storage:"fossil_frights:text",nbt:"list_players",interpret:true,color:"gold"},{score:{name:"$day_current",objective:"ff_day"},color:"gold"}]}," ",{text:"",extra:[{translate:"ff.button.run_breakdown",font:"fossil_frights:chat_buttons",color:"white"},{translate:"ff.button.run_breakdown.override",bold:true,color:"aqua"}],click_event:{action:"open_url",url:"https://zeronia.org/ff/run=$(hash)"},hover_event:{action:"show_text",value:{translate:"ff.button.run_breakdown.hover",color:"yellow",underlined:true}}}]}]}
$execute if score #list_players_amount ff_dummy matches 1 run tellraw @a {translate:"ff.messages.announcement",color:"gold",with:[{text:"",extra:[{translate:"ff.exit_day_reached.singular",with:[{storage:"fossil_frights:text",nbt:"list_players",interpret:true,color:"gold"},{score:{name:"$day_current",objective:"ff_day"},color:"gold"}]}," ",{text:"",extra:[{translate:"ff.button.run_breakdown",font:"fossil_frights:chat_buttons",color:"white"},{translate:"ff.button.run_breakdown.override",bold:true,color:"aqua"}],click_event:{action:"open_url",url:"https://zeronia.org/ff/run=$(hash)"},hover_event:{action:"show_text",value:{translate:"ff.button.run_breakdown.hover",color:"yellow",underlined:true}}}]}]}
$execute if score #list_players_amount ff_dummy matches 2.. run tellraw @a {translate:"ff.messages.announcement",color:"gold",with:[{text:"",extra:[{translate:"ff.exit_day_reached.plural",with:[{storage:"fossil_frights:text",nbt:"list_players",interpret:true,color:"gold"},{score:{name:"$day_current",objective:"ff_day"},color:"gold"}]}," ",{text:"",extra:[{translate:"ff.button.run_breakdown",font:"fossil_frights:chat_buttons",color:"white"},{translate:"ff.button.run_breakdown.override",bold:true,color:"aqua"}],click_event:{action:"open_url",url:"https://zeronia.org/ff/run=$(hash)"},hover_event:{action:"show_text",value:{translate:"ff.button.run_breakdown.hover",color:"yellow",underlined:true}}}]}]}
