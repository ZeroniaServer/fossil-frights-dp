function fossil_frights:entity/match/active
execute at @e[limit=1,type=minecraft:mannequin,tag=ff_rejoin_ghost,predicate=fossil_frights:entity/match/active] run tp @e[limit=1,type=minecraft:text_display,tag=ff_rejoin_display,predicate=fossil_frights:entity/match/active] ~ ~2.4 ~
data modify entity @e[limit=1,type=minecraft:text_display,tag=ff_rejoin_display,predicate=fossil_frights:entity/match/active] text set value {translate:"ff.rejoin.countdown",font:"fossil-frights:small_caps",color:"gray",with:[[{score:{name:"@s",objective:"ff_rejoin_minutes"}},":",{score:{name:"@s",objective:"ff_rejoin_sec_tens"}},{score:{name:"@s",objective:"ff_rejoin_sec_ones"}}]]}
