# Guard Interact
execute if entity @s[tag=ff_heist_loot_secured] as @p[tag=ff_heist_loot_clicker,scores={ff_heist_loot_security_recent=..0},distance=..10,limit=1] run function fossil_frights:game/heists/loot/secure_loot/feedback/already_secured
execute unless entity @s[tag=ff_heist_loot_secured] at @s if entity @e[type=minecraft:marker,tag=ff_heist_loot_resecure_cooldown_marker,distance=..0.25,limit=1] as @p[tag=ff_heist_loot_clicker,distance=..10,limit=1] run function fossil_frights:game/heists/loot/secure_loot/feedback/recently_secured
execute unless entity @s[tag=ff_heist_loot_secured] at @s unless entity @e[type=minecraft:marker,tag=ff_heist_loot_resecure_cooldown_marker,distance=..0.25,limit=1] if entity @s[tag=ff_heist_loot_security_active] as @p[tag=ff_heist_loot_clicker,tag=ff_heist_loot_security_active,distance=..10,limit=1] run function fossil_frights:game/heists/loot/secure_loot/refresh_hold
execute if entity @s[tag=ff_heist_loot_security_active] run scoreboard players set @s ff_heist_loot_security_lease 8
execute unless entity @s[tag=ff_heist_loot_secured] at @s unless entity @e[type=minecraft:marker,tag=ff_heist_loot_resecure_cooldown_marker,distance=..0.25,limit=1] if entity @s[tag=ff_heist_loot_security_active] as @p[tag=ff_heist_loot_clicker,tag=!ff_heist_loot_security_active,distance=..10,limit=1] run function fossil_frights:game/heists/loot/secure_loot/feedback/in_progress
execute unless entity @s[tag=ff_heist_loot_secured] at @s unless entity @e[type=minecraft:marker,tag=ff_heist_loot_resecure_cooldown_marker,distance=..0.25,limit=1] unless entity @s[tag=ff_heist_loot_security_active] run function fossil_frights:game/heists/loot/secure_loot/start_guard
